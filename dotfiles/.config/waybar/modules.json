{

    //Modules configuration
     "hyprland/workspaces": {
         "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
         "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",  
        // "disable-scroll": true,
         "tooltip": false,
         "all-outputs": true,
         "warp-on-scroll": false,
         "format": "{name}: {icon}",
         "format-icons": {
            // "1": "",
            //"2": "",
            //"3": "",
            //"4": "",
            //"5": "",
             "urgent": "",
             "active": "",
             "default": ""
         }
     },

    // Taskbar
    "wlr/taskbar": {
        "format": "{app_id}",
        //"icon-theme":"Adwatia",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "all-outputs": true,
        "ignore-list": [
           "Alacritty"
        ],
        "rewrite": {
           "google-chrome":" ",
           "kitty":" ",
           "code":" ",
           "com.microsoft.VSCode":" 󰨞",
           "zotero":" 󰬡",
           "cmake-gui":" ",
           "org.kde.dolphin":" 󱢴",
           "org.pulseaudio.pavucontrol":" 󱄠",
           "notepad++.exe":" 󱓩",
           "hyprsysteminfo":" 󰣇",
           "org.kde.konsole":" ",
           "nwg-look":" ",
           "com.obsproject.Studio":" 󰐩",
           "nvidia-settings":" 󰾲",
           "pgadmin4":" 󰟆",
           "Docker Desktop":" 󰡨",
           "nm-connection-editor":" 󰣺",
           "chromium-browser":" 󰊯",
           "burp-StartBurp":" 󰒋",
           "libreoffice-writer":" 󰷈",
           "PacketTracer":" ",
           "vlc":" 󰕼",
           "DivAcerManagerMax":" 󰈐",
           "libreoffice-startcenter":" 󰷈"
           
        }
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
   "mpd": {
       "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ",
       "format-disconnected": "Disconnected ",
       "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
       "unknown-tag": "N/A",
       "interval": 5,
       "consume-icons": {
           "on": " "
       },
       "random-icons": {
           "off": "<span color=\"#f53c3c\"></span> ",
           "on": " "
       },
       "repeat-icons": {
           "on": " "
       },
       "single-icons": {
           "on": "1 "
       },
       "state-icons": {
           "paused": "",
           "playing": ""
       },
       "tooltip-format": "MPD (connected)",
       "tooltip-format-disconnected": "MPD (disconnected)"
   },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/>
        // }
    },
    "clock": {
        "format": "{:%H:%M %a}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        // START CLOCK FORMAT
        "format-alt": "{:%Y-%m-%d}"
        // END CLOCK FORMAT
    },

    "custom/hardware-collapse": {
        "format": "",
        "on-click-middle": "~/.config/waybar/scripts/toggle_hardware.sh"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": true,
        "on-click-middle": "~/.config/waybar/scripts/toggle_hardware.sh"
    },
    "memory": {
        "format": "{}% ",
        "tooltip": true,
        "tooltip-format": "Memory Usage: {used}GiB/{total}GiB \nSwap Usage: {swapUsed}GiB/{swapTotal}GiB",
        "on-click-middle": "~/.config/waybar/scripts/toggle_hardware.sh"
    },

   "custom/gpuinfo": {
        "exec": "~/.config/waybar/scripts/gpuinfo.sh",
        "return-type": "json",
        "format": "{percentage}% 󰾲",
        "interval": 3,
        "on-click-middle": "~/.config/waybar/scripts/toggle_hardware.sh"
    },

    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󱩱", "", "", "", "","","󰈸", "󱗗"],
        "on-click-middle": "~/.config/waybar/scripts/toggle_hardware.sh"
    },
    "disk": {
        "format": "{percentage_used}% ",
        "tooltip-format": "/home: {used}/{total}",
        "path": "/home",
        "on-click-middle": "~/.config/waybar/scripts/toggle_hardware.sh"
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "o",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": " ",
        "power-saver": " "
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this >
        "format-wifi": " ",
        "format-ethernet": "󰈀",
        "format-linked": "",
        "format-disconnected": "󰖪",
        "format-disabled": "󱚿",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "tooltip-format-wifi": "{ifname} ({ipaddr}/{cidr})\nWifi-name: {essid}\nSignal: {signalStrength}%\nDownspeed: {bandwidthDownBits}\nUpspeed: {bandwidthUpBits}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "{ifname} ({ipaddr}/{cidr})\nDownspeed: {bandwidthDownBits}\nUpspeed: {bandwidthUpBits}\nGateway: {gwaddr}",
        "tooltip-format-linked": "{ifname} (No IP)",
        "tooltip-format-disconnected": "No network connection",
        "tooltip-format-disabled": "Network disabled",
        "on-click-middle": "rfkill toggle wlan",
        "on-click-right": "~/.config/waybar/scripts/toggle-nm-connection-editor.sh"
        // "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "pulseaudio": {
        //"scroll-step": 1, // %, can be a float
        "format": "{icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "  {format_source}",
        "format-source": "",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "tooltip-format": "Volume: {volume}% \nOutput: {desc}",
        "on-click": "~/.config/waybar/scripts/toggle-pavucontrol.sh"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Sc>
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify>
    },
    "custom/power": {
        "format" : "⏻  ",
                "tooltip": false,
                "menu": "on-click",
                "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file
                "menu-actions": {
                        "shutdown": "systemctl poweroff",
                        "reboot": "systemctl reboot",
                        "suspend": "systemctl suspend",
                        "hibernate": "systemctl hibernate",
                        "logout": "loginctl terminate-user $USER",
                        "lock": "loginctl lock-session"
                }
    },

    "custom/exit": {
        "format": " ",
        "on-click": "wlogout",
        "tooltip-format": "Power Menu"
    }


}
